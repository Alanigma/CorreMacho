  - m_BackGround: {fileID: 21300000, guid: a3904dfca298f094d997015b61d85c24, type: 3}
    m_Dialog: "\xD4xe?! O que tu t\xE1 fazendo, macho? Esse dinheiro n\xE3o \xE9
      teu. "
  - m_BackGround: {fileID: 21300000, guid: 45c7dd67739671e48a49b91e9c7821b2, type: 3}
    m_Dialog: "Tarde demais. Os caba te viram e eles t\xE3o invocado. "
  - m_BackGround: {fileID: 21300000, guid: cecf1e1205afad2448b799cdb8777c15, type: 3}
    m_Dialog: "Se te pegarem v\xE3o arrancar teu couro, ent\xE3o deixe de fuleiragem
      e [...] "
  - m_BackGround: {fileID: 21300000, guid: fc1d146aa87a97f4188fc1465697b4f4, type: 3}
    m_Dialog: "CORRE,\_MACHO!"
